FROM python:3.11-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

# Copy the trained model into the image as requested
COPY QueueControl/models/queueiq_xgb_model.joblib /app/QueueControl/models/queueiq_xgb_model.joblib

CMD ["python", "QueueControl/queue-simulation/queue_simulation_dashboard.py"]